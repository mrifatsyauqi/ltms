# Copy file ini menjadi .env.local dan isi nilainya. Jangan commit .env.local.

# NextAuth (Auth.js v5)
# Generate dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth Client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Opsional. Proyek ini SENGAJA TIDAK memakai domain Google Workspace (keputusan
# menggantikan PRD Bagian 4/5) — kontrol akses sepenuhnya lewat whitelist email
# di sheet Users (lihat apps-script/README.md). Biarkan kosong. Isi hanya jika
# nanti proyek ini pindah ke akun Workspace dan mau tambahan proteksi domain.
ALLOWED_GOOGLE_DOMAIN=

# Apps Script Web App (lihat apps-script/README.md untuk cara deploy)
APPS_SCRIPT_URL=
APPS_SCRIPT_SHARED_SECRET=
