# Copy file ini menjadi .env.local dan isi nilainya. Jangan commit .env.local.

# NextAuth (Auth.js v5)
# Generate dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth Client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Opsional. Proyek ini SENGAJA TIDAK memakai domain Google Workspace (keputusan
# menggantikan PRD Bagian 4/5) — kontrol akses sepenuhnya lewat whitelist email
# di tabel users Supabase. Biarkan kosong. Isi hanya jika nanti proyek ini
# pindah ke akun Workspace dan mau tambahan proteksi domain.
ALLOWED_GOOGLE_DOMAIN=

# Supabase (satu-satunya backend sejak Tahap 8). SUPABASE_URL = base URL project
# (tanpa /rest/v1). SERVICE_ROLE_KEY server-only, JANGAN pakai prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia untuk Vercel Cron (snapshot Dashboard harian). Generate: openssl rand -hex 32
CRON_SECRET=
